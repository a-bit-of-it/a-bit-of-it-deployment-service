@page "/applications/{Id:int}"
@using Frontend.Models
@using Frontend.Services
@implements IAsyncDisposable
@inject IApplicationService ApplicationService

<PageTitle>Application</PageTitle>

<div class="app-page">
    <div class="release-panel">
        <div class="panel-left">
            <h1>Manage Application releases</h1>
            @if (_application != null)
            {
                <h3 class="app-name">@_application.Name</h3>
            }
            @if (_latestRelease != null)
            {
                <span class="latest-release">Latest release: @_latestRelease.Name (@_latestRelease.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
            }
        </div>

        <div class="panel-right">
            <div class="status-area">
                <span class="status-badge @StatusCssClass(_selectedTagWorkflow)">
                    @StatusLabel(_selectedTagWorkflow)
                </span>
                @if (_isPolling)
                {
                    <span class="spinner" title="Waiting for workflow..."></span>
                }
            </div>

            <div class="actions">
                <button class="btn btn-primary"
                        disabled="@(!CanRelease || _isReleasing)"
                        @onclick="ReleaseAsync">
                    @if (_isReleasing)
                    {
                        <span class="spinner spinner-inline"></span>
                    }
                    Release
                </button>
            </div>
        </div>
    </div>

    <hr class="divider" />
    
    <div class="tag-list">
        @foreach (var tag in _tags)
        {
            <div class="tag-item @(tag.Name == _selectedTag?.Name ? "selected" : "")"
                 @onclick="() => SelectTag(tag)">
                <span class="tag-dot"></span>
                <span class="tag-name">@tag.Name</span>
            </div>
        }
    </div>

    <hr class="divider" />
    
    <div class="new-release-row">
        <button class="btn btn-secondary"
                disabled="@_isPolling"
                @onclick="CreateNewReleaseAsync">
            @if (_isPolling)
            {
                <span class="spinner spinner-inline"></span>
            }
            Create new release
        </button>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Application? _application;
    private List<Tag> _tags = new();
    private Release? _latestRelease;

    private bool _isPolling;
    private bool _isReleasing;

    private Tag? _selectedTag;
    private Workflow? _selectedTagWorkflow;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;

    private bool CanRelease =>
        _selectedTagWorkflow is { IsCompletedSuccessfully: true };
    
    private static string StatusLabel(Workflow? workflow) => workflow switch
    {
        null => "Waiting",
        { IsComplete: false } => "Running...",
        { IsComplete: true, IsCompletedSuccessfully: true } => "Completed",
        _ => "Failed"
    };

    private static string StatusCssClass(Workflow? workflow) => workflow switch
    {
        null => "status-waiting",
        { IsComplete: true, IsCompletedSuccessfully: true } => "status-success",
        { IsComplete: false } => "status-running",
        _ => "status-failure"
    };

    protected override async Task OnInitializedAsync()
    {
        _application = await ApplicationService.GetAsync(Id);
        _tags = await ApplicationService.GetTags(Id);
        _latestRelease = await ApplicationService.GetLatestRelease(Id);

        Tag? tag;
        if (_latestRelease == null)
            tag = _tags.FirstOrDefault();
        else
            tag = _tags.FirstOrDefault(t => t.Name == _latestRelease.Name);

        if (tag != null)
        {
            _selectedTagWorkflow = await ApplicationService.GetWorkflow(Id, tag.Name);
            _selectedTag = tag;
        }
        
        StateHasChanged();
    }

    private async Task SelectTag(Tag tag)
    {
        _selectedTag = _selectedTag == null || _selectedTag.Name != tag.Name
            ? tag
            : null;
        
        if (_selectedTag == null)
        {
            _selectedTagWorkflow = null;
            return;
        }

        _selectedTagWorkflow = await ApplicationService.GetWorkflow(Id, _selectedTag.Name);
    }

    private async Task ReleaseAsync()
    {
        if (!CanRelease || _selectedTag == null) return;

        _isReleasing = true;
        try
        {
            await ApplicationService.ReleaseAsync(Id, _selectedTag);

            _selectedTag = null;
            _selectedTagWorkflow = null;
            _latestRelease = await ApplicationService.GetLatestRelease(Id);
            _tags = await ApplicationService.GetTags(Id);
        }
        finally
        {
            _isReleasing = false;
        }
    }

    private async Task CreateNewReleaseAsync()
    {
        if (_isPolling) return;

        _selectedTag = await ApplicationService.CreateTag(Id);
        if (_selectedTag == null)
        {
            Console.WriteLine("Creating tag failed cannot poll.");
            return;
        }

        _tags = await ApplicationService.GetTags(Id);

        StartPolling(_selectedTag);
    }

    private void StartPolling(Tag tag)
    {
        // stop any previous poll loop before starting a new one
        StopPolling();

        _pollCts = new CancellationTokenSource();
        _isPolling = true;

        _ = PollWorkflowAsync(tag, _pollCts.Token);
    }

    private async Task PollWorkflowAsync(Tag tag, CancellationToken token)
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        try
        {
            while (await _pollTimer.WaitForNextTickAsync(token))
            {
                var workflow = await ApplicationService.GetWorkflow(Id, tag.Name, token);

                await InvokeAsync(() =>
                {
                    _selectedTagWorkflow = workflow;

                    if (workflow != null && workflow.IsComplete)
                    {
                        _isPolling = false;
                    }

                    StateHasChanged();
                });

                if (workflow != null && workflow.IsComplete)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // expected when polling is stopped or component disposed
        }
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;

        _pollTimer?.Dispose();
        _pollTimer = null;

        _isPolling = false;
    }

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}

<style>
    .app-page {
        display: flex;
        flex-direction: column;
        gap: 24px;
        /*padding: 24px;*/
    }

    .release-panel {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .divider {
        width: 100%;
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.75);
        margin: 0;
    }

    .app-name {
        font-size: 15px;
        font-weight: 500;
    }

    .latest-release {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
    }

    .panel-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .status-area {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        background: #eee;
        color: #555;
        text-transform: capitalize;
    }

    .status-badge.status-success {
        background: #dcfce7;
        color: #15803d;
    }

    .status-badge.status-failure {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-badge.status-running {
        background: #fef9c3;
        color: #a16207;
    }

    .status-badge.status-waiting {
        background: #eee;
        color: #666;
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid #d4d4d4;
        border-top-color: #4f46e5;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
    }

    .spinner-inline {
        display: inline-block;
        margin-right: 8px;
        vertical-align: middle;
        border-top-color: #fff;
        border-color: rgba(255, 255, 255, 0.4);
        border-top-color: #fff;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .actions {
        display: flex;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s ease, background 0.15s ease;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .btn-primary {
        background: #4f46e5;
        color: white;
    }

    .btn-primary:disabled {
        background: #c7c7c7;
    }

    .btn-secondary {
        background: #f1f1f4;
        color: #333;
    }

    .btn-rollback {
        background: #b91c1c;
        color: white;
        padding: 6px 14px;
        font-size: 13px;
    }

    .btn-rollback:disabled {
        background: #e2b3b3;
    }

    .btn-link {
        background: none;
        border: none;
        color: #4f46e5;
        font-weight: 600;
        cursor: pointer;
        padding: 8px 0;
    }

    .tag-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 500px;
        overflow-y: auto;
    }

    .new-release-row {
        display: flex;
        justify-content: flex-end;
    }

    .tag-item {
        width: 200px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border: 1px solid #e2e2e2;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .tag-item:hover {
        background:  #5c636a;
        color: white;
    }

    .tag-item.selected {
        background: #0d6efd;
    }

    .tag-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4f46e5;
        flex-shrink: 0;
    }

    .tag-name {
        font-weight: 600;
        color: white;
    }
    
</style>
