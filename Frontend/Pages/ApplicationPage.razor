@page "/applications/{Id:int}"
@using Frontend.Models
@using Frontend.Services
@implements IAsyncDisposable
@inject IApplicationService ApplicationService

<PageTitle>Application</PageTitle>

<div class="page">
    <div class="release-panel">
        <div class="panel-left">
            <h1>Manage Application releases</h1>
            @if (_application != null)
            {
                <h3 class="app-name">@_application.Name</h3>
            }
            @if (_latestRelease != null)
            {
                <span class="latest-release">Latest release: @_latestRelease.Name (@_latestRelease.CreatedAt.ToLocalTime())</span>
            }
        </div>

        <div class="panel-right">
            <div class="status-area">
                <span class="status-badge @StatusCssClass(_pendingWorkflow)">
                    @StatusLabel(_pendingWorkflow)
                </span>
                @if (_isPolling)
                {
                    <span class="spinner" title="Waiting for workflow..."></span>
                }
            </div>

            <div class="actions">
                <button class="btn btn-secondary"
                        disabled="@_isPolling"
                        @onclick="CreateNewReleaseAsync">
                    @if (_isPolling)
                    {
                        <span class="spinner spinner-inline"></span>
                    }
                    Create new release
                </button>

                <button class="btn btn-primary"
                        disabled="@(!CanRelease || _isReleasing)"
                        @onclick="ReleaseAsync">
                    @if (_isReleasing)
                    {
                        <span class="spinner spinner-inline"></span>
                    }
                    Release
                </button>
            </div>
        </div>
    </div>

    <div class="tag-history">
        <button class="btn btn-link tag-history-toggle" @onclick="ToggleTagHistory">
            @(_showTagHistory ? "Hide tags" : "View tags")
        </button>

        @if (_showTagHistory)
        {
            <div class="tag-detail">
                @if (_selectedTag == null)
                {
                    <span class="tag-detail-hint">Select a tag below to inspect its workflow and release.</span>
                }
                else
                {
                    <div class="tag-detail-row">
                        <span class="tag-detail-name">@_selectedTag.Name</span>
                        <span class="status-badge @StatusCssClass(_selectedTagWorkflow)">
                            @StatusLabel(_selectedTagWorkflow)
                        </span>

                        @if (_selectedTagRelease != null)
                        {
                            <span class="tag-detail-release">Release: @_selectedTagRelease.Name (@_selectedTagRelease.CreatedAt.ToLocalTime())</span>

                            <button class="btn btn-primary"
                                    disabled="@(!CanRollback || _isRollingBack)"
                                    @onclick="RollbackAsync">
                                @if (_isRollingBack)
                                {
                                    <span class="spinner spinner-inline"></span>
                                }
                                Rollback
                            </button>
                        }
                        else if (_selectedTagWorkflow is { IsComplete: true, IsCompletedSuccessfully: true })
                        {
                            <span class="tag-detail-hint">No release found for this tag.</span>
                        }
                    </div>
                }
            </div>

            @if (_tags != null)
            {
                <div class="tag-list">
                    @foreach (var tag in _tags)
                    {
                        <div class="tag-item @(tag.Name == _selectedTag?.Name ? "selected" : "")"
                             @onclick="() => SelectTag(tag)">
                            <span class="tag-dot"></span>
                            <span class="tag-name">@tag.Name</span>
                            <span class="tag-sha">@tag.CommitSha</span>
                            @if (_selectedTag != null && tag.Name == _selectedTag.Name)
                            {
                                <span class="tag-check">✓</span>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Application? _application;
    private List<Tag>? _tags;
    private Release? _latestRelease;

    // "Create new release" flow (top panel)
    private Tag? _pendingTag;
    private Workflow? _pendingWorkflow;
    private bool _isPolling;
    private bool _isReleasing;

    // Tag history flow (bottom panel)
    private bool _showTagHistory;
    private Tag? _selectedTag;
    private Workflow? _selectedTagWorkflow;
    private Release? _selectedTagRelease;
    private bool _isRollingBack;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;

    private bool CanRelease =>
        _pendingTag is not null &&
        _pendingWorkflow is { IsCompletedSuccessfully: true };

    private bool CanRollback =>
        _selectedTagRelease is not null &&
        _latestRelease is not null &&
        _selectedTagRelease.Id != _latestRelease.Id;
    
    private static string StatusLabel(Workflow? workflow) => workflow switch
    {
        null => "Waiting",
        { IsComplete: false } => "Running...",
        { IsComplete: true, IsCompletedSuccessfully: true } => "Completed",
        _ => "Failed"
    };

    private static string StatusCssClass(Workflow? workflow) => workflow switch
    {
        null => "status-waiting",
        { IsComplete: true, IsCompletedSuccessfully: true } => "status-success",
        { IsComplete: false } => "status-running",
        _ => "status-failure"
    };

    protected override async Task OnInitializedAsync()
    {
        _application = await ApplicationService.GetAsync(Id);
        _tags = await ApplicationService.GetTags(Id);
        _latestRelease = await ApplicationService.GetLatestRelease(Id);

        var tag = _tags.FirstOrDefault();
        if (tag != null)
            _pendingWorkflow = await ApplicationService.GetWorkflow(Id, tag.CommitSha);
    }

    private void ToggleTagHistory()
    {
        _showTagHistory = !_showTagHistory;
    }

    private async Task SelectTag(Tag tag)
    {
        _selectedTag = _selectedTag == null || _selectedTag.Name != tag.Name
            ? tag
            : null;

        _selectedTagRelease = null;

        if (_selectedTag == null)
        {
            _selectedTagWorkflow = null;
            return;
        }

        _selectedTagWorkflow = await ApplicationService.GetWorkflow(Id, _selectedTag.CommitSha);

        if (_selectedTagWorkflow is { IsComplete: true, IsCompletedSuccessfully: true })
            _selectedTagRelease = await ApplicationService.GetRelease(Id, _selectedTag.Name);
    }

    private async Task ReleaseAsync()
    {
        if (!CanRelease || _pendingTag == null) return;

        _isReleasing = true;
        try
        {
            await ApplicationService.ReleaseAsync(Id, _pendingTag);

            _pendingTag = null;
            _pendingWorkflow = null;
            _latestRelease = await ApplicationService.GetLatestRelease(Id);
            _tags = await ApplicationService.GetTags(Id);
        }
        finally
        {
            _isReleasing = false;
        }
    }

    private async Task RollbackAsync()
    {
        if (!CanRollback || _selectedTag == null) return;

        _isRollingBack = true;
        try
        {
            await ApplicationService.Rollback(Id, _selectedTag);

            _latestRelease = await ApplicationService.GetLatestRelease(Id);
            _selectedTagRelease = await ApplicationService.GetRelease(Id, _selectedTag.Name);
        }
        finally
        {
            _isRollingBack = false;
        }
    }

    private async Task CreateNewReleaseAsync()
    {
        if (_isPolling) return;

        _pendingTag = await ApplicationService.CreateTag(Id);
        _pendingWorkflow = null;

        _tags = await ApplicationService.GetTags(Id);

        StartPolling(_pendingTag.CommitSha);
    }

    private void StartPolling(string commitSha)
    {
        // stop any previous poll loop before starting a new one
        StopPolling();

        _pollCts = new CancellationTokenSource();
        _isPolling = true;

        _ = PollWorkflowAsync(commitSha, _pollCts.Token);
    }

    private async Task PollWorkflowAsync(string commitSha, CancellationToken token)
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        try
        {
            while (await _pollTimer.WaitForNextTickAsync(token))
            {
                var workflow = await ApplicationService.GetWorkflow(Id, commitSha, token);

                await InvokeAsync(() =>
                {
                    _pendingWorkflow = workflow;

                    if (workflow.IsComplete)
                    {
                        _isPolling = false;
                    }

                    StateHasChanged();
                });

                if (workflow.IsComplete)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // expected when polling is stopped or component disposed
        }
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;

        _pollTimer?.Dispose();
        _pollTimer = null;

        _isPolling = false;
    }

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}

<style>
    .page {
        max-width: 720px;
        margin: 0 auto;
        padding: 24px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .release-panel {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px;
        margin-bottom: 20px;
        border: 1px solid #e2e2e2;
        border-radius: 12px;
        background: #fff;
    }

    .panel-left h1 {
        font-size: 20px;
        margin: 0 0 4px 0;
        color: #1a1a1a;
    }

    .app-name {
        margin: 0;
        font-size: 15px;
        font-weight: 500;
        color: #6b6b6b;
    }

    .latest-release {
        display: inline-block;
        margin-top: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4f46e5;
    }

    .panel-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .status-area {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        background: #eee;
        color: #555;
        text-transform: capitalize;
    }

    .status-badge.status-success {
        background: #dcfce7;
        color: #15803d;
    }

    .status-badge.status-failure {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-badge.status-running {
        background: #fef9c3;
        color: #a16207;
    }

    .status-badge.status-waiting {
        background: #eee;
        color: #666;
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid #d4d4d4;
        border-top-color: #4f46e5;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
    }

    .spinner-inline {
        display: inline-block;
        margin-right: 8px;
        vertical-align: middle;
        border-top-color: #fff;
        border-color: rgba(255, 255, 255, 0.4);
        border-top-color: #fff;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .actions {
        display: flex;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s ease, background 0.15s ease;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .btn-primary {
        background: #4f46e5;
        color: white;
    }

    .btn-primary:disabled {
        background: #c7c7c7;
    }

    .btn-secondary {
        background: #f1f1f4;
        color: #333;
    }

    .btn-rollback {
        background: #b91c1c;
        color: white;
        padding: 6px 14px;
        font-size: 13px;
    }

    .btn-rollback:disabled {
        background: #e2b3b3;
    }

    .btn-link {
        background: none;
        border: none;
        color: #4f46e5;
        font-weight: 600;
        cursor: pointer;
        padding: 8px 0;
    }

    .tag-history {
        border-top: 1px solid #e2e2e2;
        padding-top: 12px;
    }

    .tag-detail {
        margin-bottom: 16px;
        padding: 14px 16px;
        border: 1px solid #e2e2e2;
        border-radius: 10px;
        background: #fafafa;
    }

    .tag-detail-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .tag-detail-name {
        font-weight: 600;
        color: #1a1a1a;
    }

    .tag-detail-release {
        font-size: 13px;
        color: #555;
    }

    .tag-detail-hint {
        font-size: 13px;
        color: #8a8a8a;
    }

    .tag-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .tag-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border: 1px solid #e2e2e2;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s ease;
        background: #fff;
    }

    .tag-item:hover {
        border-color: #b3b3b3;
        background: #fafafa;
    }

    .tag-item.selected {
        border-color: #4f46e5;
        background: #eef2ff;
    }

    .tag-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4f46e5;
        flex-shrink: 0;
    }

    .tag-name {
        font-weight: 600;
        color: #1a1a1a;
    }

    .tag-sha {
        flex: 1;
        font-family: "SF Mono", Consolas, monospace;
        font-size: 13px;
        color: #8a8a8a;
        text-align: right;
    }

    .tag-check {
        color: #4f46e5;
        font-weight: bold;
    }
</style>
