@page "/customers/{CustomerId:int}/applications/{ApplicationId:int}"
@using Frontend.Models
@using Frontend.Services
@implements IAsyncDisposable
@inject IApplicationService ApplicationService
@inject ICustomerService CustomerService

<PageTitle>Application</PageTitle>

<div class="app-page">
    <div class="release-panel">
        <div class="panel-left">
            <h1>Manage Application</h1>
            @if (_application != null && _customer != null)
            {
                <nav class="breadcrumb" aria-label="breadcrumb">
                    <a href="customers/@_customer.Id">@_customer.Name</a>
                    <span class="breadcrumb-current">@_application.Name</span>
                </nav>
            }
            @if (_latestRelease != null)
            {
                <span class="latest-release">Latest release: @_latestRelease.Name (@_latestRelease.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
            }
        </div>

        <div class="panel-right">
            <div class="status-area">
                Workflow:
                <span class="status-badge @StatusCssClass(_selectedTagWorkflow)">
                    @StatusLabel(_selectedTagWorkflow)
                </span>
                @if (_isPolling)
                {
                    <span class="spinner" title="Waiting for workflow..."></span>
                }
            </div>

            <div class="actions">
                <button class="btn btn-primary"
                        disabled="@(!CanRelease || _isReleasing)"
                        @onclick="ReleaseAsync">
                    @if (_isReleasing)
                    {
                        <span class="spinner spinner-inline"></span>
                    }
                    Release
                </button>
            </div>
        </div>
    </div>

    <hr class="divider" />
    
    <h3>Components</h3>
    
    <div class="container-list">
        @foreach (var container in _containers)
        {
            <div class="container-item">
                <span class="container-dot @ContainerStatusCssClass(container.IsRunning)"></span>
                <div class="container-details">
                    <span class="container-name">@container.Name</span>
                    <span class="container-status">@container.Status</span>
                    <span class="container-status">@container.Image</span>
                </div>
            </div>
        }
    </div>
    
    <hr class="divider" />
    
    <div class="tags-header">
        <h3>Tags</h3>
        <button class="btn btn-secondary"
                disabled="@_isPolling"
                @onclick="CreateNewTagAsync">
            @if (_isPolling)
            {
                <span class="spinner spinner-inline"></span>
            }
            Create new tag
        </button>
    </div>
    
    
    <div class="tag-list">
        @foreach (var tag in _tags)
        {
            <div class="tag-item @(tag.Name == _selectedTag?.Name ? "selected" : "")"
                 @onclick="() => SelectTag(tag)">
                <span class="tag-dot"></span>
                <span class="tag-name">@tag.Name</span>
            </div>
        }
    </div>

    <hr class="divider" />
</div>

@code {
    [Parameter]
    public int CustomerId { get; set; } 
    
    [Parameter]
    public int ApplicationId { get; set; }

    private Application? _application;
    private Customer? _customer;
    
    private List<Tag> _tags = new();
    private List<ContainerInfo> _containers = new();
    private Release? _latestRelease;

    private bool _isPolling;
    private bool _isReleasing;

    private Tag? _selectedTag;
    private Workflow? _selectedTagWorkflow;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;

    private bool CanRelease =>
        _selectedTag != null
        && _selectedTagWorkflow is { IsCompletedSuccessfully: true }
        && (_latestRelease == null || _selectedTag.Name != _latestRelease.Name);
    
    private static string StatusLabel(Workflow? workflow) => workflow switch
    {
        null => "Waiting",
        { IsComplete: false } => "Running...",
        { IsComplete: true, IsCompletedSuccessfully: true } => "Completed",
        _ => "Failed"
    };

    private static string StatusCssClass(Workflow? workflow) => workflow switch
    {
        null => "status-waiting",
        { IsComplete: true, IsCompletedSuccessfully: true } => "status-success",
        { IsComplete: false } => "status-running",
        _ => "status-failure"
    };

    private static string ContainerStatusCssClass(bool isRunning) =>
        isRunning ? "online" : "offline";

    protected override async Task OnInitializedAsync()
    {
        // TODO A BFF would be nice
        _application = await ApplicationService.GetAsync(ApplicationId);
        _customer = await CustomerService.GetAsync(CustomerId);
        _tags = await ApplicationService.GetTags(ApplicationId);
        _latestRelease = await ApplicationService.GetLatestRelease(ApplicationId);
        _containers = await ApplicationService.GetContainers(ApplicationId);

        Tag? tag;
        if (_latestRelease == null)
            tag = _tags.FirstOrDefault();
        else
            tag = _tags.FirstOrDefault(t => t.Name == _latestRelease.Name);

        if (tag != null)
        {
            _selectedTagWorkflow = await ApplicationService.GetWorkflow(ApplicationId, tag.Name);
            _selectedTag = tag;
        }
        
        StateHasChanged();
    }

    private async Task SelectTag(Tag tag)
    {
        _selectedTag = _selectedTag == null || _selectedTag.Name != tag.Name
            ? tag
            : null;
        
        if (_selectedTag == null)
        {
            _selectedTagWorkflow = null;
            return;
        }

        _selectedTagWorkflow = await ApplicationService.GetWorkflow(ApplicationId, _selectedTag.Name);
    }

    private async Task ReleaseAsync()
    {
        if (!CanRelease || _selectedTag == null) return;

        _isReleasing = true;
        try
        {
            await ApplicationService.ReleaseAsync(ApplicationId, _selectedTag);

            _selectedTag = null;
            _selectedTagWorkflow = null;
            _latestRelease = await ApplicationService.GetLatestRelease(ApplicationId);
            _tags = await ApplicationService.GetTags(ApplicationId);
        }
        finally
        {
            _isReleasing = false;
        }
    }

    private async Task CreateNewTagAsync()
    {
        if (_isPolling) return;

        _selectedTag = await ApplicationService.CreateTag(ApplicationId);
        _selectedTagWorkflow = null;
        
        if (_selectedTag == null)
        {
            Console.WriteLine("Creating tag failed cannot poll.");
            return;
        }

        _tags.Insert(0, _selectedTag);
        
        StateHasChanged();

        StartPolling(_selectedTag);
    }

    private void StartPolling(Tag tag)
    {
        // stop any previous poll loop before starting a new one
        StopPolling();

        _pollCts = new CancellationTokenSource();
        _isPolling = true;

        _ = PollWorkflowAsync(tag, _pollCts.Token);
    }

    private async Task PollWorkflowAsync(Tag tag, CancellationToken token)
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        try
        {
            while (await _pollTimer.WaitForNextTickAsync(token))
            {
                var workflow = await ApplicationService.GetWorkflow(ApplicationId, tag.Name, token);

                await InvokeAsync(() =>
                {
                    _selectedTagWorkflow = workflow;

                    if (workflow != null && workflow.IsComplete)
                    {
                        _isPolling = false;
                    }

                    StateHasChanged();
                });

                if (workflow != null && workflow.IsComplete)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // expected when polling is stopped or component disposed
        }
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;

        _pollTimer?.Dispose();
        _pollTimer = null;

        _isPolling = false;
    }

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}

<style>
    .app-page {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .release-panel {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .tags-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 18px;
    }

    .breadcrumb a {
        text-decoration: none;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .breadcrumb-current {
    }

    .breadcrumb > * + *::before {
        content: "/";
        margin-right: 8px;
    }

    .divider {
        width: 100%;
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.75);
        margin: 0;
    }

    .app-name {
        font-size: 15px;
        font-weight: 500;
    }

    .latest-release {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
    }

    .panel-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .status-area {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        background: #eee;
        color: #555;
        text-transform: capitalize;
    }

    .status-badge.status-success {
        background: #dcfce7;
        color: #15803d;
    }

    .status-badge.status-failure {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-badge.status-running {
        background: #fef9c3;
        color: #a16207;
    }

    .status-badge.status-waiting {
        background: #eee;
        color: #666;
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid #d4d4d4;
        border-top-color: #4f46e5;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
    }

    .spinner-inline {
        display: inline-block;
        margin-right: 8px;
        vertical-align: middle;
        border-top-color: #fff;
        border-color: rgba(255, 255, 255, 0.4);
        border-top-color: #fff;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .actions {
        display: flex;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s ease, background 0.15s ease;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .btn-primary {
        background: #4f46e5;
        color: white;
    }

    .btn-primary:disabled {
        background: #c7c7c7;
    }

    .btn-secondary {
        background: #f1f1f4;
        color: #333;
    }

    .btn-rollback {
        background: #b91c1c;
        color: white;
        padding: 6px 14px;
        font-size: 13px;
    }

    .btn-rollback:disabled {
        background: #e2b3b3;
    }

    .btn-link {
        background: none;
        border: none;
        color: #4f46e5;
        font-weight: 600;
        cursor: pointer;
        padding: 8px 0;
    }

    .status-row {
        display: flex;
        gap: 24px;
    }

    .tag-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 500px;
        overflow-y: auto;
    }

    .container-list {
        display: flex;
        flex-direction: row;
        gap: 8px;
        max-height: 500px;
        overflow-y: auto;
    }

    .container-item {
        width: 400px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border: 1px solid #e2e2e2;
        border-radius: 10px;
    }

    .container-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        background: #eee;
    }

    .container-dot.online {
        background: #15803d;
    }

    .container-dot.offline {
        background: #b91c1c;
    }

    .container-details {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .container-name {
        font-weight: 600;
        color: white;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .container-status {
        font-size: 12px;
        opacity: 0.7;
    }

    .new-release-row {
        display: flex;
        justify-content: flex-end;
    }

    .tag-item {
        width: 175px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px;
        border: 1px solid #e2e2e2;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .tag-item:hover {
        background:  #5c636a;
        color: white;
    }

    .tag-item.selected {
        background: #0d6efd;
    }

    .tag-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4f46e5;
        flex-shrink: 0;
    }

    .tag-name {
        font-weight: 600;
        color: white;
    }
    
</style>
