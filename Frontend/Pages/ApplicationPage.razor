@page "/applications/{Id:int}"
@using Frontend.Models
@using Frontend.Services
@implements IAsyncDisposable
@inject IApplicationService ApplicationService

<PageTitle>Application</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1>Manage Application releases</h1>
            @if (_application != null)
            {
                <h3 class="app-name">@_application.Name</h3>
            }
            @if (_latestRelease != null)
            {
                <span class="latest-release">Latest release: @_latestRelease.Name (@_latestRelease.CreatedAt.ToLocalTime())</span>
            }
        </div>

        @if (_workflow != null)
        {
            <div class="status-area">
                <span class="status-badge @StatusCssClass">
                    @(_workflow.IsComplete ? "Completed" : "Running...")
                </span>
                @if (_isPolling)
                {
                    <span class="spinner" title="Waiting for workflow..."></span>
                }
            </div>
        }
    </div>
    
    <div class="actions">
        <button class="btn btn-secondary"
                disabled="@_isPolling"
                @onclick="CreateTagAsync">
            @if (_isPolling)
            {
                <span class="spinner spinner-inline"></span>
            }
            Create Tag at latest commit
        </button>

        <button class="btn btn-primary"
                disabled="@(!CanRelease)"
                @onclick="ReleaseAsync">
            Release
        </button>
    </div>

    @if (_tags != null)
    {
        <div class="tag-list">
            @foreach (var tag in _tags)
            {
                <div class="tag-item @(tag.Name == _selectedTag?.Name ? "selected" : "")"
                     @onclick="() => SelectTag(tag)">
                    <span class="tag-dot"></span>
                    <span class="tag-name">@tag.Name</span>
                    <span class="tag-sha">@tag.CommitSha</span>
                    @if (_selectedTag != null && tag.Name == _selectedTag.Name)
                    {
                        <span class="tag-check">✓</span>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Application? _application;
    private List<Tag>? _tags;
    private Tag? _selectedTag;
    private Workflow? _workflow;
    private Release? _latestRelease;
    private bool _isPolling;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;

    private bool CanRelease =>
        _selectedTag is not null &&
        _workflow is { IsCompletedSuccessfully: true };

    private string StatusCssClass => _workflow switch
    {
        { IsComplete: true, IsCompletedSuccessfully: true } => "status-success",
        { IsComplete: true, IsCompletedSuccessfully: false } => "status-failure",
        { IsComplete: false } => "status-running",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        _application = await ApplicationService.GetAsync(Id);
        _tags = await ApplicationService.GetTags(Id);
        _latestRelease = await ApplicationService.GetLatestRelease(Id);

        var tag = _tags.FirstOrDefault();
        if (tag != null)
            await SelectTag(tag);
    }

    private async Task SelectTag(Tag tag)
    {
        if (_selectedTag == null)
        {
            _selectedTag = tag;
        }
        else
        {
            // click again to deselect, or swap selection
            _selectedTag = _selectedTag.Name == tag.Name ? null : tag;    
        }

        if (_selectedTag == null)
            _workflow = null;
        else
            _workflow = await ApplicationService.GetWorkflow(Id, _selectedTag.CommitSha);
    }

    private async Task ReleaseAsync()
    {
        if (!CanRelease) return;

        var selectedTag = _tags!.First(t => t.Name == _selectedTag.Name);
        await ApplicationService.ReleaseAsync(Id, selectedTag);

        _selectedTag = null;
        _latestRelease = await ApplicationService.GetLatestRelease(Id);
    }

    private async Task CreateTagAsync()
    {
        if (_isPolling) return;

        var newTag = await ApplicationService.CreateTag(Id);

        _tags = await ApplicationService.GetTags(Id);

        StartPolling(newTag.CommitSha);
    }

    private void StartPolling(string commitSha)
    {
        // stop any previous poll loop before starting a new one
        StopPolling();

        _pollCts = new CancellationTokenSource();
        _isPolling = true;

        _ = PollWorkflowAsync(commitSha, _pollCts.Token);
    }

    private async Task PollWorkflowAsync(string commitSha, CancellationToken token)
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        try
        {
            while (await _pollTimer.WaitForNextTickAsync(token))
            {
                var workflow = await ApplicationService.GetWorkflow(Id, commitSha, token);

                await InvokeAsync(() =>
                {
                    _workflow = workflow;

                    if (workflow.IsComplete)
                    {
                        _isPolling = false;
                    }

                    StateHasChanged();
                });

                if (workflow.IsComplete)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // expected when polling is stopped or component disposed
        }
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;

        _pollTimer?.Dispose();
        _pollTimer = null;

        _isPolling = false;
    }

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}

<style>
    .page {
        max-width: 720px;
        margin: 0 auto;
        padding: 24px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .page-header h1 {
        font-size: 20px;
        margin: 0 0 4px 0;
        color: #1a1a1a;
    }

    .app-name {
        margin: 0;
        font-size: 15px;
        font-weight: 500;
        color: #6b6b6b;
    }

    .latest-release {
        display: inline-block;
        margin-top: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #4f46e5;
    }

    .status-area {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        background: #eee;
        color: #555;
        text-transform: capitalize;
    }

    .status-badge.status-success {
        background: #dcfce7;
        color: #15803d;
    }

    .status-badge.status-failure {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-badge.status-running {
        background: #fef9c3;
        color: #a16207;
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid #d4d4d4;
        border-top-color: #4f46e5;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
    }

    .spinner-inline {
        display: inline-block;
        margin-right: 8px;
        vertical-align: middle;
        border-top-color: #fff;
        border-color: rgba(255, 255, 255, 0.4);
        border-top-color: #fff;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .tag-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

    .tag-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border: 1px solid #e2e2e2;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s ease;
        background: #fff;
    }

    .tag-item:hover {
        border-color: #b3b3b3;
        background: #fafafa;
    }

    .tag-item.selected {
        border-color: #4f46e5;
        background: #eef2ff;
    }

    .tag-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4f46e5;
        flex-shrink: 0;
    }

    .tag-name {
        font-weight: 600;
        color: #1a1a1a;
    }

    .tag-sha {
        flex: 1;
        font-family: "SF Mono", Consolas, monospace;
        font-size: 13px;
        color: #8a8a8a;
        text-align: right;
    }

    .tag-check {
        color: #4f46e5;
        font-weight: bold;
    }

    .actions {
        display: flex;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s ease, background 0.15s ease;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .btn-primary {
        background: #4f46e5;
        color: white;
    }

    .btn-primary:disabled {
        background: #c7c7c7;
    }

    .btn-secondary {
        background: #f1f1f4;
        color: #333;
    }
</style>
