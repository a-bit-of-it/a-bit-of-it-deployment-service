@page "/servers/{Id:int}"
@using Frontend.Models
@using Frontend.Services
@inject IServerService ServerService

<PageTitle>Server</PageTitle>

<div class="page-header">
    <h1>Server @(_server?.Ip ?? "")</h1>
</div>

@if (_components is null)
{
    <p><em>Loading...</em></p>
}
else if (!_components.Any())
{
    <p>No components found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Container</th>
                <th>Status</th>
                <th>Image</th>
                <th>Ports</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var component in _components)
            {
                <tr>
                    <td>@component.Name</td>
                    <td>
                        <span class="status-dot @(component.IsRunning ? "online" : "offline")"></span>
                        @component.Status
                    </td>
                    <td>@component.Image</td>
                    <td>@component.Ports</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Server? _server;
    private List<ContainerInfo>? _components;

    protected override async Task OnInitializedAsync()
    {
        _server = await ServerService.GetAsync(Id);
        _components = await ServerService.GetComponents(Id);
    }
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .table {
        /*Overwrite bootstrap default colors*/
        --bs-table-bg: transparent;
        --bs-table-color: white;
        --bs-table-border-color: rgba(255, 255, 255, 0.15);
        width: auto;
    }

    .status-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 6px;
        background: #eee;
    }

    .status-dot.online {
        background: #15803d;
    }

    .status-dot.offline {
        background: #b91c1c;
    }
</style>
